# Public site URL (used for canonical, sitemap, OG, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://seablings.org

# Google Gemini API key for /api/news route
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Neon Postgres connection string for /api/submissions
# Get from your Neon project dashboard (Connection Details -> Pooled connection)
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require
